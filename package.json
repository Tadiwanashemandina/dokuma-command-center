{
  "name": "dokuma-command-centre",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run build --workspace @dokuma/shared && concurrently -n shared,server,client -c gray,cyan,magenta \"npm:dev:shared\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:shared": "npm run dev --workspace @dokuma/shared",
    "dev:server": "npm run dev --workspace @dokuma/server",
    "dev:client": "npm run dev --workspace @dokuma/client",
    "build": "npm run build --workspace @dokuma/shared && npm run build --workspace @dokuma/server && npm run build --workspace @dokuma/client",
    "typecheck": "npm run build --workspace @dokuma/shared && npm run typecheck --workspace @dokuma/server && npm run typecheck --workspace @dokuma/client",
    "lint": "eslint .",
    "legacy:dev": "next dev",
    "legacy:build": "next build",
    "legacy:start": "next start",
    "legacy:lint": "next lint",
    "vercel-build": "npm run build --workspace @dokuma/shared && npm run build --workspace @dokuma/client"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0",
    "mongodb": "^7.6.0",
    "next": "14.2.35",
    "next-themes": "^0.4.6",
    "papaparse": "^5.6.0",
    "radix-ui": "^1.6.7",
    "react": "^18",
    "react-dom": "^18",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vercel/node": "^5.10.2",
    "concurrently": "^9.1.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8.18.0"
  }
}
