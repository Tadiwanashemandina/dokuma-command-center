# Supabase project (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only. Never expose to the browser. Used by the LazyBoss CSV import
# Server Action to bypass RLS after an app-level admin role check.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# LazyBoss data source: 'csv' (default) or 'api' once a real API adapter exists.
LAZYBOSS_SOURCE=csv
