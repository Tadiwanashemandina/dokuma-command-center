# Supabase project (Project Settings -> API in the Supabase dashboard)
MONGODB_ONLY=true
NEXT_PUBLIC_MONGODB_ONLY=true
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=dokuma
LOCAL_ADMIN_EMAIL=admin@dokuma.local
LOCAL_ADMIN_PASSWORD=DokumaTest123!

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only. Never expose to the browser. Used by the LazyBoss CSV import
# Server Action to bypass RLS after an app-level admin role check.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# LazyBoss data source: 'csv' (default) or 'api' once a real API adapter exists.
LAZYBOSS_SOURCE=csv

# Atlassian/Jira Cloud REST API, for the Employee 360 profile's read-only
# task list (JQL: assignee = employees.jira_account_id). Generate an API
# token at id.atlassian.com/manage-profile/security/api-tokens for an
# account with read access to your Jira projects.
JIRA_SITE_URL=https://your-site.atlassian.net
JIRA_EMAIL=your-atlassian-account-email
JIRA_API_TOKEN=your-atlassian-api-token

# ---------------------------------------------------------------------------
# Xero accounting integration
# ---------------------------------------------------------------------------
# Create an app at developer.xero.com/app/manage. Choose "Web app"; the
# Client Secret is shown once at creation and cannot be retrieved later.
#
# FAIL-CLOSED: with any of these missing or malformed, the integration resolves
# to mode "disabled" with a stated reason, and no OAuth flow, sync or push can
# run. A missing variable can only ever make this system quieter — never make
# it write into a real accounting ledger.
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret

# Must match the redirect URI registered in the Xero app EXACTLY, and must be
# https (localhost is exempt, as Xero itself permits it for development).
XERO_REDIRECT_URI=https://your-domain.example.com/finance/xero

# disabled | read-only | live   (default: live)
#   read-only requests no write scope at all, so the push cannot fire even by
#   mistake. Run in read-only first and watch the sync reconcile correctly
#   before enabling writes.
XERO_MODE=read-only

# ---------------------------------------------------------------------------
# Jira (Atlassian Cloud)
# ---------------------------------------------------------------------------
# Create a token at id.atlassian.com/manage-profile/security/api-tokens
# Auth is HTTP Basic with email:token — NOT a Bearer token (that is OAuth).
# Unset or left as these placeholders, the integration is disabled and nothing
# calls Atlassian.
JIRA_SITE_URL=https://your-site.atlassian.net
JIRA_EMAIL=your-atlassian-account-email
JIRA_API_TOKEN=your-atlassian-api-token
# Optional: comma-separated project keys to sync. Blank = every project the
# token can see.
JIRA_PROJECT_KEYS=
